# Proprietary customer documentation (DO NOT COMMIT)
# These files contain customer-specific information and should never be committed
**/dnb_er/**
**/DNB_**
**/*_dnb_*
**/*_DNB_*
# If we reference these docs locally, they must remain local only
docs/private/**
docs/customer/**

# Legacy code (archived implementations)
# Foxx services and related code moved to legacy/ for historical reference
# Not actively maintained or tested in v2.0+
legacy/

# UI frontend build artifacts (rebuilt from ui/ source)
src/entity_resolution/ui/static/

# Runtime artifacts (models, benchmarks, caches)
artifacts/
# Coverage and analysis artifacts (never track)
coverage.json
COVERAGE_SUMMARY.txt
detailed_coverage_analysis_*.json

# Local Claude Code harness config (per-user, not project-shared)
.claude/*
# Skills are source and meant to be shared -- but only ones reviewed for private
# content (absolute paths, internal endpoints) are un-ignored, one at a time.
!.claude/skills/
.claude/skills/*
!.claude/skills/pr-review/
!.claude/skills/code-quality-review/
# .cursor/ is per-user, except the estate-wide rules that are reviewed and tracked.
# (A directory pattern like `.cursor/` cannot be re-included from, hence `/*`.)
.cursor/*
!.cursor/rules/
.cursor/rules/*
!.cursor/rules/fix-upstream-dont-fork.mdc
.prd-drift-queue/
CLAUDE.md

# Playwright
ui/test-results/
ui/playwright-report/
ui/blob-report/
ui/.playwright/
.no-drift-gate

# /prd-sync fallback records (replayed to memory DB, then deleted)
.prd-sync-pending/

# Cached public benchmark datasets (downloaded by scripts/run_er_benchmarks.py)
.benchmark_data/
.cursor/.shared-memory-sessions/
.cursor/hooks.json.pre-update.*
.cursor/hooks/*.pre-update.*

# Session-mined candidate memories awaiting /pattern-save triage
.pattern-capture-queue/
.cursor/rules/*.mdc.pre-update.*

# Personal author bio for outreach drafts; never commit
docs/outreach/author-bio.md
